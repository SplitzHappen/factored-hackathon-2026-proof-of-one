# Runtime data mode. Public/demo default is fully synthetic.
# For organizer-backed local evaluation outside the public default Compose surface,
# set DATA_MODE=curated, point BANK_DB_PATH at the locally built curated artifact, and
# use a separate curated runtime SQLite path. Raw organizer files are never used by the app.
DATA_MODE=synthetic
BANK_DB_PATH=runtime/synthetic-demo.duckdb
RUNTIME_DB_PATH=runtime/synthetic-runtime.sqlite
PORT=8000

# Interpretation provider. Default remains deterministic and requires no live LLM.
# Set INTERPRETATION_PROVIDER=openai-gpt-6-luna only after the selected provider
# has passed the governed qualification gates and OPENAI_API_KEY is configured.
INTERPRETATION_PROVIDER=deterministic

# Copy to .env locally if desired. .env files are ignored by Git.
# Never commit real provider credentials.

# OpenAI
OPENAI_API_KEY=

# Alibaba Cloud Model Studio / Qwen
DASHSCOPE_API_KEY=
# Optional. Default: Singapore shared compatibility endpoint.
# Prefer your workspace-dedicated Singapore endpoint when available.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

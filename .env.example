# Runtime data mode. The local/default Compose surface is intentionally synthetic.
# The hosted judge-facing Render deployment is configured separately with DATA_MODE=curated,
# a mounted full challenge-data artifact, and a separate curated runtime SQLite path.
# Raw organizer files are never read directly by the application.
DATA_MODE=synthetic
BANK_DB_PATH=runtime/synthetic-demo.duckdb
RUNTIME_DB_PATH=runtime/synthetic-runtime.sqlite
PORT=8000

# Interpretation provider. Local/default execution remains deterministic and requires no live LLM.
# The hosted judge-facing deployment explicitly uses openai-gpt-6-luna after governed qualification,
# with OPENAI_API_KEY supplied only as a deployment secret.
INTERPRETATION_PROVIDER=deterministic

# Copy to .env locally if desired. .env files are ignored by Git.
# Never commit real provider credentials.

# OpenAI
OPENAI_API_KEY=

# Alibaba Cloud Model Studio / Qwen
DASHSCOPE_API_KEY=
# Optional. Default: Singapore shared compatibility endpoint.
# Prefer your workspace-dedicated Singapore endpoint when available.
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
